import requests
import frappe


def get_tally_settings():
    settings = frappe.get_all(
        "Tally Settings",
        filters={"enabled": 1},
        fields=[
            "name",
            "tally_host",
            "tally_port",
            "tally_company"
        ],
        limit=1
    )

    if not settings:
        frappe.throw("No enabled Tally Settings found.")

    return settings[0]


def send_to_tally(xml_data):
    settings = get_tally_settings()

    host = settings.tally_host
    port = settings.tally_port or 9000

    url = f"http://{host}:{port}"

    try:
        response = requests.post(
            url,
            data=xml_data.encode("utf-8"),
            headers={
                "Content-Type": "text/xml; charset=utf-8"
            },
            timeout=30
        )

        return {
            "success": True,
            "status_code": response.status_code,
            "response": response.text
        }

    except requests.exceptions.ConnectionError:
        return {
            "success": False,
            "response": f"Cannot connect to Tally at {url}"
        }

    except requests.exceptions.Timeout:
        return {
            "success": False,
            "response": "Tally connection timed out"
        }

    except Exception as e:
        frappe.log_error(
            frappe.get_traceback(),
            "Tally Integration Error"
        )

        return {
            "success": False,
            "response": str(e)
        }
